# 256-wiki — environment template
# Copy to .env.local for local dev. In production these are injected into the
# Lambda environment at deploy (ansible-vault → env per 256-infra conventions).
# Every name here is listed in STATE.md → "Needs Tyler" for provisioning.

# ── Content pack ────────────────────────────────────────────────────────────
# GitHub release asset fetched at build time (public, no token needed).
# Leave empty to auto-discover the latest `pack-v*` release of public-mining-brain.
WIKI_PACK_REPO=256foundation/public-mining-brain
WIKI_PACK_URL=

# ── LLM adapter (OpenAI-compatible; OpenRouter dedicated key) ────────────────
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=set-me-openrouter-dedicated-key
# Primary + fallback are config, not code. Site copy never hardcodes model names.
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_FALLBACK_MODEL=z-ai/glm-flash-latest
# Daily token budget for the circuit breaker (prompt+completion, all chat paths).
LLM_DAILY_TOKEN_BUDGET=3000000

# ── Cloudflare Turnstile (anonymous ask + suggest form) ─────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# server-side siteverify secret; unset = dev bypass (verification skipped)
TURNSTILE_SECRET=

# ── Identity (Phase 2; all optional — anonymous quota works without them) ────
# Signed HTTP-only session cookie (openssl rand -hex 32)
SESSION_SECRET=
# GitHub OAuth app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authentik OIDC ("Sign in with 256 Foundation") — team/unlimited tier
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ISSUER_URL=
# Authentik group claim that marks 256F team (unlimited quota; config, not code)
AUTHENTIK_TEAM_GROUP=256f-team

# ── GitHub (suggest form → issue; weekly gap report) ────────────────────────
GITHUB_TOKEN=
GITHUB_TARGET_REPO=256foundation/public-mining-brain

# ── AWS (Lambda runtime env; local dev usually leaves these empty) ───────────
AWS_REGION=us-east-1
QUOTAS_TABLE=256-wiki-quotas
ANSWERS_TABLE=256-wiki-answers-cache
QUERYLOG_TABLE=256-wiki-query-log

# ── Live strip (Phase 1; cached ≥60s, never scrape dash.256f.org) ────────────
POOL_PROM_URL=https://pool.256foundation.org
MEMPOOL_API_URL=https://mempool.space/api
